{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShakeChat",
  "version": "1.9.1",
  "identifier": "com.shakethat.shakechat",
  "build": {
    "beforeDevCommand": "node ../../tools/apply-desktop-native-voice-v0.1.mjs && npm run dev -w @shakechat/web -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node ../../tools/apply-desktop-native-voice-v0.1.mjs && npm run build -w @shakechat/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ShakeChat",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/shakethat01/ShakeChat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
